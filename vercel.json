{
  "redirects": [
    { "source": "/", "destination": "/climate/", "permanent": false },
    { "source": "/index.html", "destination": "/climate/", "permanent": false },
    { "source": "/:v(stitch|monitor|apple|material|line)", "destination": "/climate/", "permanent": false },
    { "source": "/:v(stitch|monitor|apple|material|line)/:path*", "destination": "/climate/", "permanent": false }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
